// Slide-friendly (stacked, ~16:9) variant of the ModelOps pipeline flow.
// Render: dot -Tpng modelops_pipeline_flow_slide.dot -o modelops_pipeline_flow_slide.png
digraph modelops_slide {
  rankdir=TB;
  fontname="Helvetica";
  labelloc="t";
  fontsize=26;
  label="ModelOps: Secure Model Onboarding Pipeline (OpenShift AI)";
  nodesep=0.28;
  ranksep=0.85;
  compound=true;
  dpi=150;

  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13,
        color="#4a4a4a", fillcolor="#eaf2fb", penwidth=1.4, margin="0.12,0.08"];
  edge [fontname="Helvetica", fontsize=11, color="#4a4a4a"];

  // ---- Phase 1: Sandbox governance (namespace: vllm) -----------------------
  subgraph cluster_p1 {
    label="Phase 1 - Sandbox governance   (namespace: vllm, automated)";
    labelloc="t"; margin=18;
    style="rounded,filled"; fillcolor="#f4f8fd"; color="#3b73b9"; fontsize=15; fontcolor="#3b73b9";

    compliance [label="Compliance +\nArtifact Scan\n(skopeo + Trivy)\n[GATE 1]", fillcolor="#fADBD8", color="#c0392b", penwidth=2.4, shape=octagon];
    adv1       [label="GPU Advisor\n(sandbox)"];
    share1     [label="Apply GPU\nSharing"];
    deploy1    [label="Deploy Model\n(KServe/vLLM)"];
    garak      [label="Security Scan\n(garak)\n[GATE 2]", fillcolor="#fADBD8", color="#c0392b", penwidth=2.4, shape=octagon];
    teardown   [label="Teardown\nsandbox"];

    compliance -> adv1 -> share1 -> deploy1 -> garak -> teardown;
    { rank=same; compliance; adv1; share1; deploy1; garak; teardown; }
  }

  // ---- Phase 2: Promote to staging (namespace: vllm-staging) ---------------
  subgraph cluster_p2 {
    label="Phase 2 - Promote to staging / models-as-a-service   (namespace: vllm-staging, human-gated)";
    labelloc="t"; margin=18;
    style="rounded,filled"; fillcolor="#f4fbf5"; color="#2e8b57"; fontsize=15; fontcolor="#2e8b57";

    adv2      [label="GPU Advisor\n(staging)"];
    approval  [label="Wait for\nApproval\n(human gate)", fillcolor="#fcefc7", color="#b7950b", penwidth=2.4, shape=octagon];
    share2    [label="Apply GPU\nSharing"];
    deploy2   [label="Deploy Model\n(staging)"];
    grant     [label="Grant Model\nAccess (RBAC)"];
    bench     [label="Benchmark\n(GuideLLM)"];
    upload    [label="Upload\nResults (S3)"];
    register  [label="Register Model\n(PRODUCTION-\nREADY)", fillcolor="#d5f5e3", color="#1e8449", penwidth=2.4];

    adv2 -> approval -> share2 -> deploy2 -> grant -> bench -> upload -> register;
    { rank=same; adv2; approval; share2; deploy2; grant; bench; upload; register; }
  }

  // ---- External systems (bottom row) ---------------------------------------
  quay      [label="Quay modelcar catalog\n(OCI model weights)", fillcolor="#fde9d9", shape=cylinder];
  ui        [label="Model Intake UI\n(submit + approval)", fillcolor="#e9f7e9", shape=note];
  registry  [label="OpenShift AI\nModel Registry", fillcolor="#e6e0f8", shape=cylinder];
  s3        [label="S3 / MinIO\n(scan + benchmark\nartifacts)", fillcolor="#fdf6d9", shape=cylinder];
  dashboard [label="OpenShift AI Dashboard\n(per-user visibility:\nalice yes / bob no)", fillcolor="#e9f7e9", shape=note];
  { rank=same; quay; ui; registry; s3; dashboard; }

  // ---- Cross-phase / system flows ------------------------------------------
  teardown -> adv2 [label="free GPU,\npromote", color="#3b73b9", penwidth=2, weight=10];

  quay -> compliance [style=dashed, color="#c07a30", constraint=false];
  ui   -> compliance [label="submit", style=dashed, color="#2e8b57", constraint=false];
  approval -> ui [dir=both, style=dashed, color="#2e8b57", constraint=false];

  compliance -> registry [style=dotted, color="#6f57c0", constraint=false];
  garak      -> registry [style=dotted, color="#6f57c0", constraint=false];
  register   -> registry [style=dotted, color="#6f57c0", constraint=false];

  compliance -> s3 [style=dotted, color="#b7950b", constraint=false];
  garak      -> s3 [style=dotted, color="#b7950b", constraint=false];
  upload     -> s3 [style=dotted, color="#b7950b", constraint=false];

  grant -> dashboard [label="grant view\n(staging only)", style=dashed, color="#2e8b57", constraint=false];
}
